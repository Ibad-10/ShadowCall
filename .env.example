# Copy to .env and fill in. Never commit .env. Values below were checked live on Sat 24 Oct 2026.
SHADOWCALL_MODE=mock                # mock (offline) | live (calls Mubit)
MUBIT_API_KEY=                      # Mubit key for the VERIFIED project ("learning on")
MUBIT_API_KEY_RAW=                  # optional: second project fed raw frontier replies ("learning off" arm)
# Frontier lane. Starter credit serves: gpt-6-sol, gpt-6.1-sol, gpt-6-luna, gpt-6-astra, gpt-5.5, gpt-4o-mini, gpt-4.1-mini.
# Changing the model later creates NEW Mubit tasks (model is part of a task's identity).
TEACHER_MODEL=gpt-6-sol
MUBIT_TEACHER_BASE_URL=https://api.mubit.ai/openai/v1
TEACHER_EXTRA_BODY={"reasoning_effort":"low"}
TEACHER_SEND_TEMPERATURE=false      # reasoning models reject non-default temperature
TEACHER_RESAMPLE_EFFORTS=medium,high,high   # corrections: re-ask with more thinking
TEACHER_SEND_SESSION_METADATA=false # OpenAI rejects metadata unless store=true
# Open-model lane: Groq via Mubit compat, covered by the starter credit (no provider key needed).
# Model IDs are Groq's own: openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b.
SHADOW_MODEL=openai/gpt-oss-20b
MUBIT_SHADOW_BASE_URL=https://api.mubit.ai/compat/groq/v1
SHADOW_EXTRA_BODY={"reasoning_effort":"low"}
SHADOW_SEND_SESSION_METADATA=false  # Groq: "metadata is not supported with this model"
MUBIT_ADAPTER_BASE_URL=             # only if Mubit staff expose a callable adapter
MUBIT_ADAPTER_MODEL=
BANYAN_API_URL=                     # Banyan Sapling endpoint (hosted by Mubit or self-hosted on a GPU)
BANYAN_API_KEY=
SHADOWCALL_ELEVENLABS_SECRET=       # the secret you set in ElevenLabs' custom-LLM config
SHADOWCALL_BUFFER_WORDS=            # e.g. "One moment... " to cover first-token latency
SHADOWCALL_VERIFIED_KEEP=true
SHADOWCALL_CORRECTION=turn          # turn = show the frontier its mistake and the checker's findings; off = straight to the Fix queue
SHADOWCALL_MAX_RESAMPLES=0          # plain resamples fixed nothing live
SHADOWCALL_KEEP_CAP=0               # >0: stop record=full per sub-task at this many keeps (stay under Mubit's 25)
SHADOWCALL_MAX_TOKENS=1500
SHADOWCALL_AUDIT_RATE=0.2
GATE_MIN_HELDOUT=20
GATE_MARGIN=0.0
# Pence per 1M tokens at ~75p/US$: gpt-6-sol $2/$10 (OpenAI pricing page), gpt-oss-20b $0.075/$0.30 (Groq models page).
TEACHER_PENCE_PER_MTOK_IN=150
TEACHER_PENCE_PER_MTOK_OUT=750
SHADOW_PENCE_PER_MTOK_IN=5.6
SHADOW_PENCE_PER_MTOK_OUT=22.5
# Web app and sign-in
SHADOWCALL_AUTH=true                # false = no sign-in (local only; never on the internet)
SHADOWCALL_SIGNUP=true              # false = invite-only; recommended when hosted publicly
SHADOWCALL_COOKIE_SECURE=auto       # auto = Secure cookie when the request is HTTPS (or X-Forwarded-Proto says so)
DEMO_USER=                          # e.g. demo@yourdomain; seeded at start-up when both are set
DEMO_PASSWORD=                      # at least 10 characters; changing it re-hashes on the next start
SHADOWCALL_DB=                      # SQLite path; default data/shadowcall.db (use a persistent disk when hosted)
